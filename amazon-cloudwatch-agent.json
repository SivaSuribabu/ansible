{
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "cpu": {
        "resources": ["*"],
        "measurement": [
          {
            "name": "cpu_usage_idle",
            "rename": "CPUIdlePercent",
            "unit": "Percent"
          }
        ],
        "totalcpu": true
      },
      "mem": {
        "measurement": [
          {
            "name": "mem_used_percent",
            "rename": "MemoryUsagePercent",
            "unit": "Percent"
          }
        ]
      },
      "disk": {
        "resources": ["/"],
        "measurement": [
          {
            "name": "used_percent",
            "rename": "DiskUsagePercent",
            "unit": "Percent"
          }
        ]
      }
    }
  }
}
